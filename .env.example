DATABASE_URL=postgres://postgres:postgres@localhost:5432/remates
# DATABASE_REPLICA_URL=postgres://postgres:postgres@replica:5432/remates
DATABASE_MAX_CONNECTIONS=20
BIND_ADDR=0.0.0.0:8080
# Al menos 32 bytes. Los tokens los emite la Parte 2 (identidad).
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32-bytes
JWT_ISSUER=paraguay-remates
RUN_MIGRATIONS=true
RUN_WORKERS=true
# CORS_ALLOWED_ORIGINS=https://paraguayremates.com
# LOG_FORMAT=json
